; Engine configuration file.
config_version=5

[application]

config/name="Vespergard"
config/description="A gothic soulslike of glory and ruin."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

DB="*res://src/core/db.gd"
World="*res://src/core/world_state.gd"
Game="*res://src/core/game.gd"
StateDirector="*res://src/core/state_director.gd"
AudioDirector="*res://src/core/audio_director.gd"
Juice="*res://src/core/juice.gd"
Shot="*res://src/debug/shot.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unused_parameter=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/aspect="expand"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
cam_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0)]
}
cam_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0)]
}
cam_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0)]
}
cam_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0)]
}
dodge={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":1)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325), Object(InputEventJoypadButton,"device":-1,"button_index":1)]
}
attack_light={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1), Object(InputEventJoypadButton,"device":-1,"button_index":10)]
}
attack_heavy={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":67), Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)]
}
block={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":2), Object(InputEventJoypadButton,"device":-1,"button_index":9)]
}
parry={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81), Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0)]
}
flask={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82), Object(InputEventJoypadButton,"device":-1,"button_index":2)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69), Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
lock_on={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306), Object(InputEventMouseButton,"device":-1,"button_index":3), Object(InputEventJoypadButton,"device":-1,"button_index":8)]
}
menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":6)]
}

[layer_names]

3d_physics/layer_1="world_base"
3d_physics/layer_2="world_glory"
3d_physics/layer_3="world_ruin"
3d_physics/layer_4="player"
3d_physics/layer_5="enemy"
3d_physics/layer_6="hurtbox"
3d_physics/layer_7="interact"
3d_physics/layer_8="camera_clip"

[physics]

common/physics_ticks_per_second=60

[rendering]

lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=false
environment/defaults/default_clear_color=Color(0.04, 0.045, 0.06, 1)

[shader_globals]

vg_wave_r={
"type": "float",
"value": -1000.0
}
vg_wave_origin={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
vg_wave_dir={
"type": "float",
"value": 1.0
}
vg_state_blend={
"type": "float",
"value": 0.0
}
vg_wave_band={
"type": "float",
"value": 4.0
}
vg_wave_color={
"type": "vec3",
"value": Vector3(1, 0.78, 0.42)
}
