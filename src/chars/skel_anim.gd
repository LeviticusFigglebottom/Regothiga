## Compose clip tables onto a skeleton's rest pose. skel_path is the track
## path prefix from the AnimationPlayer's root node to the Skeleton3D.
## Every clip keys every bone (rest for the unlisted ones) so poses are
## deterministic and cross-fades never inherit stale limbs.
static func build_library(skel: Skeleton3D, skel_path: NodePath, amp := 1.0, sway := 1.0) -> AnimationLibrary:
	var lib := AnimationLibrary.new()
	var rest_q := {}
	var rest_p := {}
	var bone_names: Array[String] = []
	for i in skel.get_bone_count():
		var n := skel.get_bone_name(i)
		bone_names.append(n)
		rest_q[n] = skel.get_bone_rest(i).basis.get_rotation_quaternion()
		rest_p[n] = skel.get_bone_rest(i).origin
	var clips := _clips(amp, sway)
	for clip_name in clips:
		var c: Dictionary = clips[clip_name]
		var anim := Animation.new()
		anim.length = c["len"]
		if c.get("loop", false):
			anim.loop_mode = Animation.LOOP_LINEAR
		var keyed_rot: Dictionary = c.get("bones", {})
		var keyed_pos: Dictionary = c.get("pos", {})
		for bone in bone_names:
			var t := anim.add_track(Animation.TYPE_ROTATION_3D)
			anim.track_set_path(t, NodePath(String(skel_path) + ":" + bone))
			anim.track_set_interpolation_type(t, Animation.INTERPOLATION_CUBIC)
			if keyed_rot.has(bone):
				for k in keyed_rot[bone]:
					var e := Vector3(deg_to_rad(k[1]), deg_to_rad(k[2]), deg_to_rad(k[3]))
					var q: Quaternion = rest_q[bone] * Quaternion.from_euler(e)
					anim.rotation_track_insert_key(t, k[0], q)
			else:
				anim.rotation_track_insert_key(t, 0.0, rest_q[bone])
		for bone in keyed_pos:
			if not rest_p.has(bone):
				continue
			var t2 := anim.add_track(Animation.TYPE_POSITION_3D)
			anim.track_set_path(t2, NodePath(String(skel_path) + ":" + bone))
			anim.track_set_interpolation_type(t2, Animation.INTERPOLATION_CUBIC)
			for k in keyed_pos[bone]:
				anim.position_track_insert_key(t2, k[0], rest_p[bone] + Vector3(k[1], k[2], k[3]))
		if not keyed_pos.has("hips") and rest_p.has("hips"):
			var t3 := anim.add_track(Animation.TYPE_POSITION_3D)
			anim.track_set_path(t3, NodePath(String(skel_path) + ":hips"))
			anim.position_track_insert_key(t3, 0.0, rest_p["hips"])
		lib.add_animation(clip_name, anim)
	# aliases
	var dup := {"atk_double": "atk_r", "atk_cast": "cast"}
	for alias in dup:
		if lib.has_animation(dup[alias]):
			lib.add_animation(alias, lib.get_animation(dup[alias]))
	return lib
